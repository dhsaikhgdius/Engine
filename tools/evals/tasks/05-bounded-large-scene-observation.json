    {
      "label": "query bounded radius",
      "tool": "director_workbench",
      "input": {
        "op": "query_objects",
        "spatial": {
          "mode": "radius",
          "center": [
            0,
            0,
            0
          ],
          "radius_m": 20
        },
        "include_hidden": false,
        "max_results": 5
      },
      "expect": {
        "success": true,
        "result_paths": [
          "result.objects.0.id",
          "result.returned_count",
          "result.truncated",
          "result.project_revision"
        ]
      }
    },
    {
      "label": "observe bounded hierarchy",
      "tool": "director_workbench",
      "input": {
        "op": "observe",
        "fields": [
          "objects"
        ],
        "object_mode": "hierarchy",
        "max_objects": 5
      },
      "expect": {
        "success": true,
        "result_paths": [
          "result.objects.roots",
          "result.objects.truncated",
          "result.project_revision"
        ]
      }
