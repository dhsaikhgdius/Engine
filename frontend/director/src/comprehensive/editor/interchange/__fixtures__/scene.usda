#usda 1.0
(
    defaultPrim = "DirectorScene"
    metersPerUnit = 1
    upAxis = "Y"
    customLayerData = {
        string directorAdapter = "director-usd-v1"
        string directorContract = "director-interchange-v1"
        string directorHandedness = "right"
    }
)

def Xform "DirectorScene"
{
    def Xform "FixtureMarker" (
        customData = {
            string directorAdapter = "director-usd-v1"
            string directorContract = "director-interchange-v1"
            string directorStableId = "fixture-usd-object-001"
            string directorEntityType = "object"
            string directorKind = "prop"
            string directorDisplayName = "USD Marker"
        }
    )
    {
        double3 xformOp:translate = (2, 1, -3)
        double3 xformOp:rotateXYZ = (0, 90, 0)
        double3 xformOp:scale = (1, 1, 1)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ", "xformOp:scale"]
    }

    def Camera "FixtureCamera" (
        customData = {
            string directorAdapter = "director-usd-v1"
            string directorContract = "director-interchange-v1"
            string directorStableId = "fixture-usd-camera-001"
            string directorEntityType = "camera"
            string directorDisplayName = "USD Camera"
            double directorFov = 42
        }
    )
    {
        double3 xformOp:translate = (0, 2, 6)
        double3 xformOp:rotateXYZ = (0, 45, 0)
        double3 xformOp:scale = (1, 1, 1)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ", "xformOp:scale"]
        float focalLength = 50
        float focusDistance = 6
        float fStop = 2.8
        float2 clippingRange = (0.1, 1000)
    }
}
