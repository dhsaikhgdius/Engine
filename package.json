{
  "name": "worldengine",
  "version": "0.3.1",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/di",
    "packages/model-provider",
    "packages/scene-pipeline",
    "packages/protocol",
    "packages/agent-engine",
    "packages/stage-protocol",
    "packages/dcc-protocol",
    "packages/project-schema",
    "packages/dcc-interchange",
    "packages/dsh-plugin-workbench"
  ],
  "scripts": {
    "dev": "concurrently -k -n gateway,ui -c yellow,cyan \"npm:dev:gateway\" \"npm:dev:ui\"",
    "dev:ui": "vite --config tools/vite.config.ts --host 127.0.0.1",
    "dev:gateway": "tsx watch backend/gateway/agent-gateway.ts",
    "blender": "node tools/scripts/blender.mjs run",
    "blender:test": "node tools/scripts/blender.mjs test",
    "build": "tsc --noEmit -p tools/tsconfig.json && vite build --config tools/vite.config.ts && node tools/scripts/check-build-chunk-budget.mjs && npm run build:mcp-plugin",
    "build:mcp-plugin": "esbuild backend/gateway/mcp-server.ts --bundle --platform=node --format=esm --target=node20 --outfile=integrations/plugins/director-workbench/mcp/server.mjs && node tools/scripts/normalize-generated-mcp-bundle.mjs",
    "docs:dev": "npm --prefix docs/site run dev",
    "docs:build": "npm --prefix docs/site run build",
    "docs:preview": "npm --prefix docs/site run preview",
    "preview": "vite preview --config tools/vite.config.ts --host 127.0.0.1",
    "gateway": "tsx backend/gateway/agent-gateway.ts",
    "setup:ltx2": "node tools/scripts/bootstrap-ltx2-source.mjs",
    "setup:hunyuan3d": "node tools/scripts/bootstrap-inference-source.mjs vendor/hunyuan3d.lock.json",
    "setup:trellis": "node tools/scripts/bootstrap-inference-source.mjs vendor/trellis.lock.json",
    "setup:ardy": "node tools/scripts/bootstrap-inference-source.mjs vendor/ardy.lock.json",
    "dsh": "tsx tools/scripts/dsh-director.mjs",
    "dsh:prepare": "tsx tools/scripts/dsh-director.mjs --prepare-only",
    "mcp": "tsx backend/gateway/mcp-server.ts",
    "stage": "node tools/scripts/stage-cli.mjs",
    "test": "npm run test:core",
    "eval": "node tools/evals/run.mjs",
    "eval:reference": "node tools/evals/live-reference-case.mjs",
    "test:core": "vitest run --config tools/vitest.config.ts",
    "test:e2e": "playwright test --config tools/e2e/playwright.config.ts",
    "test:assets": "node tools/scripts/run-local-asset-tests.mjs",
    "test:all": "npm run test:core && npm run test:assets",
    "assets:status": "node tools/scripts/director-assets.mjs status",
    "assets:install": "node tools/scripts/director-assets.mjs install",
    "assets:verify": "node tools/scripts/director-assets.mjs verify --required-only",
    "assets:release-check": "node tools/scripts/director-assets.mjs release-check",
    "repo:check": "node tools/scripts/check-open-source-boundary.mjs && node tools/scripts/check-native-agent-integration.mjs && node tools/scripts/check-doc-gateway-paths.mjs && node tools/scripts/check-i18n-completeness.mjs",
    "sync:skills": "node tools/scripts/sync-agent-skills.mjs",
    "sync:blender-operations": "node tools/scripts/sync-blender-operation-manifest.mjs",
    "lint": "NODE_OPTIONS='--max-old-space-size=4096' eslint --config tools/eslint.config.js frontend/director/src frontend/director/tests backend/gateway tools/scripts packages/protocol/src packages/protocol/tests packages/dsh-plugin-workbench/src packages/dsh-plugin-workbench/tests tools/vite.config.ts tools/vitest.config.ts && tsx tools/scripts/checkServerImportBoundaries.ts",
    "format": "prettier --write \"frontend/director/{src,tests}/**/*.{ts,tsx,css}\" \"backend/gateway/**/*.ts\" \"packages/protocol/{src,tests}/**/*.{ts,tsx}\" \"tools/*.{js,ts,json}\" \"tools/e2e/*.{js,ts}\" \"*.{json,md,yml}\"",
    "format:check": "prettier --check \"frontend/director/{src,tests}/**/*.{ts,tsx,css}\" \"backend/gateway/**/*.ts\" \"packages/protocol/{src,tests}/**/*.{ts,tsx}\" \"tools/*.{js,ts,json}\" \"tools/e2e/*.{js,ts}\" \"*.{json,md,yml}\"",
    "format:check:changed": "node tools/scripts/format-check-changed.mjs",
    "test:agent": "vitest run --config tools/vitest.config.ts frontend/director/tests/agent",
    "test:comprehensive": "vitest run --config tools/vitest.config.ts frontend/director/tests/comprehensive",
    "validate:agent-plugin": "python3 \"${CODEX_HOME:-$HOME/.codex}/skills/.system/skill-creator/scripts/quick_validate.py\" integrations/plugins/director-workbench/skills/director-workbench && python3 \"${CODEX_HOME:-$HOME/.codex}/skills/.system/plugin-creator/scripts/validate_plugin.py\" integrations/plugins/director-workbench",
    "postinstall": "node-gyp rebuild --directory=node_modules/node-pty || echo \"node-pty native build skipped (may need Xcode CLT)\"",
    "dcc:blender:status": "npm run stage -- director_dcc '{\"op\":\"status\"}'"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "0.12.0",
    "@gltf-transform/core": "4.4.2",
    "@gltf-transform/extensions": "4.4.2",
    "@modelcontextprotocol/sdk": "1.29.0",
    "@react-three/drei": "^9.122.0",
    "@react-three/fiber": "^8.17.14",
    "@sparkjsdev/spark": "^2.1.0",
    "@tanstack/react-virtual": "^3.14.9",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "draco3dgltf": "1.5.7",
    "jszip": "^3.10.1",
    "katex": "0.16.27",
    "lucide-react": "^0.469.0",
    "meshoptimizer": "1.2.0",
    "node-pty": "^1.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.184.0",
    "three-mesh-bvh": "0.7.8",
    "three-stdlib": "^2.36.1",
    "ws": "8.21.1",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.31",
    "zod": "4.4.3",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/draco3dgltf": "1.4.3",
    "@types/node": "latest",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/three": "^0.184.1",
    "@types/ws": "latest",
    "@vitejs/plugin-react": "^4.6.0",
    "autoprefixer": "^10.5.4",
    "concurrently": "10.0.4",
    "esbuild": "^0.28.1",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^29.0.1",
    "postcss": "^8.5.24",
    "prettier": "^3.9.6",
    "tailwindcss": "^3.4.19",
    "tsx": "4.23.1",
    "typescript": "~5.7.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^6.1.0",
    "vitest": "^4.1.2"
  },
  "overrides": {
    "@hono/node-server": "2.0.12"
  }
}
