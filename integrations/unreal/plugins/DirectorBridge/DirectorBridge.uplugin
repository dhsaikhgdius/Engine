  "VersionName": "0.4.0",
  "FriendlyName": "Director Bridge",
  "Description": "Imports Director exchange packages into a level with stable director_id tags, keys hash-pinned animation bakes into Sequencer (rational frame rates, timecode, camera cuts, focal length), imports skinned GLBs as skeletal meshes, maps Director PBR materials to material instances (binding bundled texture images to texture parameters), spawns the supported subset of Director lights, and exports director-dcc-return-v1 packages back to Director. Source-only connector; uses the licensed Unreal Engine installation on this machine.",
  "Category": "Director",
  "CreatedBy": "Director (WorldEngine)",
  "CreatedByURL": "",
  "CanContainContent": true,
  "IsBetaVersion": true,
  "Installed": true,
  "EnabledByDefault": true,
  "Plugins": [
    {
      "Name": "PythonScriptPlugin",
      "Enabled": true
    },
    {
      "Name": "EditorScriptingUtilities",
      "Enabled": true
    },
    {
      "Name": "LevelSequenceEditor",
      "Enabled": true
    }
  ]
}
