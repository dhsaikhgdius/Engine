{
  // Canonical TypeScript project (`tsc --noEmit -p tools/tsconfig.json`).
  // Source trees keep a one-line `extends` so the IDE finds this file when
  // walking upward from `frontend/director/`, `backend/gateway/`, or `packages/`.
  "compilerOptions": {
    "target": "ES2023",
    "useDefineForClassFields": true,
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "allowJs": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "types": ["vite/client", "node", "vitest/globals"]
  },
  "include": [
    "../frontend/director/src",
    "../frontend/director/tests",
    "../backend/gateway",
    "../packages/protocol/src",
    "../packages/protocol/tests",
    "../packages/dsh-plugin-workbench/src",
    "../packages/dsh-plugin-workbench/tests",
    "./vite.config.ts",
    "./vitest.config.ts",
    "./vitest.setup.ts",
    "./e2e/playwright.config.ts",
    "./e2e/vite.config.e2e.ts",
    "./e2e/vite.config.golden.ts"
  ]
}
