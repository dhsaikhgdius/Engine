{
  "name": "game-demo-fighting-recipe-hostfree",
  "description": "Discover the fighting demo recipe, plan from its brief template, bind player/enemy/spawn per the hints, then score the recipe acceptance script (attack plus dash through guard) to a literally playable receipt through the host-free runner — no inline trace.",
  "steps": [
    {
      "label": "describe the fighting recipe",
      "tool": "director_game",
      "input": { "op": "describe", "target": "demo_recipes.fighting" },
      "expect": {
        "success": true,
        "result_paths": [
          "result.recipe.brief.requirement",
          "result.recipe.bind_hints.1.role_id",
          "result.recipe.acceptance_script.steps.4.input.dash"
        ],
        "result_equals": { "result.recipe.genre": "fighting" }
      }
    },
    {
      "label": "plan from the recipe brief",
      "tool": "director_game",
      "input": {
        "op": "plan",
        "slice_id": "game-eval-demo-fighting-01",
        "brief": {
          "requirement": "Close the distance across the duel circle, dash through the opponent's guard, and land one attack on the training opponent.",
          "genre": "fighting",
          "perspective": "third",
          "engine_target": "stage",
          "style": "white-box clay (metric, untextured silhouettes)"
        }
      },
      "expect": {
        "success": true,
        "result_paths": ["result.slice.id"],
        "result_equals": { "result.slice.status": "draft" }
      }
    },
    {
      "label": "bind the hinted roles",
      "tool": "director_game",
      "input": {
        "op": "bind",
        "slice_id": "game-eval-demo-fighting-01",
        "bindings": [
          { "role_id": "player", "object_id": "duel-hero-1", "source": "catalog" },
          { "role_id": "enemy-1", "object_id": "duel-opponent-1", "source": "catalog" },
          { "role_id": "spawn", "object_id": "duel-spawn-1", "source": "project" }
        ]
      },
      "expect": {
        "success": true,
        "result_paths": ["result.suggested_playtest_script.steps"],
        "result_equals": { "result.bind_complete": true, "result.slice.status": "bound" }
      }
    },
    {
      "label": "host-free playtest with the recipe acceptance script",
      "tool": "director_game",
      "input": {
        "op": "playtest",
        "slice_id": "game-eval-demo-fighting-01",
        "script": {
          "steps": [
            { "frames": 16, "input": { "forward": true }, "expect": { "verb": "move" } },
            { "frames": 10, "input": { "look_right": true }, "expect": { "verb": "look" } },
            { "frames": 8, "input": { "jump": true }, "expect": { "verb": "jump" } },
            { "frames": 6, "input": { "fire": true }, "expect": { "verb": "attack" } },
            { "frames": 8, "input": { "forward": true, "dash": true }, "expect": { "verb": "dash" } }
          ]
        }
      },
      "expect": {
        "success": true,
        "result_paths": ["result.trace.contract", "result.trace.samples.0.frame"],
        "result_equals": { "result.evaluation.playable": true, "result.slice.status": "playable" }
      }
    },
    {
      "label": "evaluate the stored playable receipt",
      "tool": "director_game",
      "input": { "op": "evaluate", "slice_id": "game-eval-demo-fighting-01" },
      "expect": {
        "success": true,
        "result_equals": { "result.evaluation.playable": true }
      }
    }
  ]
}
