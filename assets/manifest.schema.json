{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Director Asset Manifest",
  "description": "Version-pinned mapping from Hugging Face artifacts to Director runtime paths.",
  "type": "object",
  "additionalProperties": false,
  "required": ["manifestVersion", "release", "repositories", "licenses", "files"],
  "properties": {
    "$schema": { "type": "string" },
    "manifestVersion": { "const": 1 },
    "release": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "description": { "type": "string", "maxLength": 2000 },
    "repositories": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/repository" }
    },
    "licenses": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/license" }
    },
    "files": {
      "type": "array",
      "items": { "$ref": "#/$defs/file" }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "provider", "repoType", "repoId", "revision", "access"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "provider": { "const": "huggingface" },
        "repoType": { "enum": ["dataset", "model"] },
        "repoId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._-]+/[A-Za-z0-9._-]+$"
        },
        "revision": {
          "description": "Immutable Hugging Face commit SHA; branches and tags are not accepted.",
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "access": { "enum": ["public", "gated", "private"] },
        "tokenEnv": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]*$"
        }
      }
    },
    "license": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "redistribution"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "name": { "type": "string", "minLength": 1, "maxLength": 256 },
        "spdx": { "type": "string", "minLength": 1, "maxLength": 128 },
        "url": { "type": "string", "format": "uri" },
        "noticePath": { "$ref": "#/$defs/safePath" },
        "redistribution": { "enum": ["public", "gated", "local-only"] },
        "notes": { "type": "string", "maxLength": 2000 }
      }
    },
    "safePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "bundle", "source", "localPath", "sha256", "size", "mediaType", "licenseRef", "required"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "bundle": { "$ref": "#/$defs/identifier" },
        "source": {
          "oneOf": [{ "$ref": "#/$defs/huggingFaceSource" }, { "$ref": "#/$defs/userProvidedSource" }]
        },
        "localPath": {
          "allOf": [{ "$ref": "#/$defs/safePath" }, { "pattern": "^assets/library/.+" }]
        },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "size": { "type": "integer", "minimum": 0 },
        "mediaType": { "type": "string", "minLength": 1, "maxLength": 128 },
        "licenseRef": { "$ref": "#/$defs/identifier" },
        "required": { "type": "boolean" },
        "description": { "type": "string", "maxLength": 1000 }
      }
    },
    "huggingFaceSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "repositoryId", "remotePath"],
      "properties": {
        "kind": { "const": "huggingface" },
        "repositoryId": { "$ref": "#/$defs/identifier" },
        "remotePath": { "$ref": "#/$defs/safePath" }
      }
    },
    "userProvidedSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "instructions"],
      "properties": {
        "kind": { "const": "user-provided" },
        "instructions": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "instructionsUrl": { "type": "string", "format": "uri" }
      }
    }
  }
}
